# Copia este archivo a .env solo si quieres probar en local contra una base
# de datos real en la nube. Si lo dejas sin DATABASE_URL, la app usa un
# Postgres embebido en disco (carpeta data/) automáticamente.

# La inyecta Vercel solo cuando conectas un Postgres desde su Marketplace
# (pestaña "Storage" del proyecto). No hace falta ponerla a mano en producción.
# DATABASE_URL=postgres://usuario:password@host/basededatos?sslmode=require

# Obligatoria en producción: firma las sesiones de los usuarios. Genérala con
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# y pégala como variable de entorno en Vercel (Settings → Environment Variables).
SESSION_SECRET=

# Opcional: minutos que dura un turno antes de que los pedidos se borren
# solos (por defecto 25).
# MINUTOS_TURNO=25

# --- Avisos diarios de las 10:30 -----------------------------------------

# Obligatoria para que funcionen los avisos: es la contraseña con la que el
# cron externo llama a /api/avisar. Sin ella, esa ruta responde 503 y no manda
# nada. Genérala igual que SESSION_SECRET.
CRON_TOKEN=

# Opcionales: las claves que firman los avisos. Si no las pones, el servidor
# genera un par la primera vez y lo guarda en la base de datos, que es lo
# cómodo. Solo tiene sentido fijarlas a mano si algún día cambias de base de
# datos y quieres que los móviles ya suscritos sigan recibiendo avisos.
# Se generan con: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Opcional: correo de contacto que se manda a los servicios de push por si hay
# problemas con tus avisos. Lo pide el estándar.
# VAPID_SUBJECT=mailto:tucorreo@ejemplo.com
